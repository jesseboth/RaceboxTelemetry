<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Data Fields to Send"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose which telemetry data to send to the endpoint:"
        android:textSize="14sp"
        android:paddingBottom="16dp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkboxSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Speed"
        android:textSize="16sp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkboxGLat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="G-Lateral (Side g-force)"
        android:textSize="16sp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkboxGLong"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="G-Longitudinal (Forward/Brake g-force)"
        android:textSize="16sp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkboxLatitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Latitude"
        android:textSize="16sp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkboxLongitude"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Longitude"
        android:textSize="16sp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkboxSatellites"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Satellite Count"
        android:textSize="16sp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkboxTimestamp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Timestamp"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="?android:attr/listDivider" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Frequency"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/frequencyLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="10 Hz (100ms interval)"
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <com.google.android.material.slider.Slider
        android:id="@+id/frequencySlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="1"
        android:valueTo="25"
        android:value="10"
        android:stepSize="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1 Hz\n(1000ms)"
            android:textSize="12sp"
            android:gravity="start" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="25 Hz\n(40ms)"
            android:textSize="12sp"
            android:gravity="end" />
    </LinearLayout>


</LinearLayout>
