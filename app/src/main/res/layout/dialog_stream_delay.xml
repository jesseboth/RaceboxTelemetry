<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Video Stream Delay"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delayInfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="ⓘ"
            android:textSize="20sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            style="@style/Widget.Material3.Button.IconButton" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="?android:attr/listDivider" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/videoDelayLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1500 ms (1.5 seconds)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"
        android:gravity="center" />

    <com.google.android.material.slider.Slider
        android:id="@+id/videoDelaySlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="5000"
        android:value="1500"
        android:stepSize="100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 ms\n(No delay)"
            android:textSize="12sp"
            android:gravity="start" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5000 ms\n(5 seconds)"
            android:textSize="12sp"
            android:gravity="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="?android:attr/listDivider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Send Frequency"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/frequencyInfoButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="ⓘ"
            android:textSize="20sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            style="@style/Widget.Material3.Button.IconButton" />
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/frequencyLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="10 Hz (100ms interval)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"
        android:gravity="center" />

    <com.google.android.material.slider.Slider
        android:id="@+id/frequencySlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="1"
        android:valueTo="25"
        android:value="10"
        android:stepSize="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1 Hz\n(1000ms)"
            android:textSize="12sp"
            android:gravity="start" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="25 Hz\n(40ms)"
            android:textSize="12sp"
            android:gravity="end" />
    </LinearLayout>

</LinearLayout>
