<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Video Stream Delay"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sync telemetry overlay with RTMP stream delay. Adjust this value to match the latency of your video stream in OBS."
        android:textSize="14sp"
        android:paddingBottom="16dp" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="How to find your delay:"
        android:textSize="14sp"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Start your RTMP stream to OBS\n2. Hard brake while driving\n3. Watch when the G-meter reacts vs. the video\n4. Adjust until they match"
        android:textSize="12sp"
        android:paddingBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="16dp"
        android:background="?android:attr/listDivider" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/videoDelayLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1500 ms (1.5 seconds)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"
        android:gravity="center" />

    <com.google.android.material.slider.Slider
        android:id="@+id/videoDelaySlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="0"
        android:valueTo="5000"
        android:value="1500"
        android:stepSize="100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 ms\n(No delay)"
            android:textSize="12sp"
            android:gravity="start" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5000 ms\n(5 seconds)"
            android:textSize="12sp"
            android:gravity="end" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:background="?android:attr/listDivider" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Typical values:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:paddingBottom="4dp" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="• 360p local: 800-1200ms\n• 360p network: 1500-2000ms\n• 720p/1080p: 2000-3000ms"
        android:textSize="12sp" />

</LinearLayout>
