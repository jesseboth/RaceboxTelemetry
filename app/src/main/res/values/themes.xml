<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.RaceBoxTelemetry" parent="Theme.Material3.Dark">
        <!-- Disable dynamic colors by using static parent theme -->
        <item name="colorPrimary">@color/racebox_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/racebox_blue_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/racebox_blue</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="colorTertiary">@color/racebox_blue</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Dark background colors -->
        <item name="android:colorBackground">@color/dark_grey</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnBackground">@color/white</item>
    </style>

    <style name="Theme.RaceBoxTelemetry" parent="Base.Theme.RaceBoxTelemetry" />
</resources>
